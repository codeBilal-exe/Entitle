# Copy to .env for local runs. Never commit real values.

SECRET_KEY=change-me-to-a-long-random-string
VAULT_KEY=
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
DEMO_RECIPIENT=

N8N_BASE_URL=
N8N_SHARED_SECRET=change-me-shared-secret
BASE_URL=http://127.0.0.1:8000

# One admin and two staff accounts. Created on startup. Not shown on the sign-in page.
ADMIN_EMAIL=admin@rightpath.local
ADMIN_PASSWORD=change-me-admin
STAFF_ONE_EMAIL=staff.one@rightpath.local
STAFF_ONE_PASSWORD=change-me-staff-1
STAFF_TWO_EMAIL=staff.two@rightpath.local
STAFF_TWO_PASSWORD=change-me-staff-2

PORT=8000
DATABASE_URL=sqlite:///./data/rightpath.db
REPLAY_MODE=false
ENABLE_SCHEDULER=true
WATCHER_INTERVAL_SECONDS=120
FETCH_REMOTE=true
