# Copy to .env for local runs. Never commit real values.

SECRET_KEY=change-me-to-a-long-random-string
VAULT_KEY=
# One key, or a comma-separated circle. When Groq rate-limits or rejects a key, the next one is used.
GROQ_API_KEY=
GROQ_API_KEYS=
LLM_MODEL=openai/gpt-oss-120b

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
DEMO_RECIPIENT=

N8N_BASE_URL=
N8N_SHARED_SECRET=change-me-shared-secret
BASE_URL=http://127.0.0.1:8000

# Demo accounts. Created on startup. Not shown on the sign-in page.
# See docs/DEMO_ACCOUNTS.md and docs/DEMO_FLOW.md.
ADMIN_EMAIL=admin@rightpath.local
ADMIN_PASSWORD=demo-admin
STAFF_ONE_EMAIL=staff.one@rightpath.local
STAFF_ONE_PASSWORD=demo-staff
STAFF_TWO_EMAIL=staff.two@rightpath.local
STAFF_TWO_PASSWORD=demo-staff-2
CITIZEN_EMAIL=citizen@rightpath.local
CITIZEN_PASSWORD=demo-citizen
CITIZEN_DISPLAY_NAME=Hina Khan

PORT=8000
DATABASE_URL=sqlite:///./data/rightpath.db
REPLAY_MODE=false
ENABLE_SCHEDULER=true
WATCHER_INTERVAL_SECONDS=120
FETCH_REMOTE=true
