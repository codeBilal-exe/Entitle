# Copy to .env for local runs. Never commit real values.

SECRET_KEY=change-me-to-a-long-random-string

# One Groq key, or a comma-separated list. A rate-limited key hands over to the next one.
GROQ_API_KEY=
GROQ_API_KEYS=
LLM_MODEL=openai/gpt-oss-120b

# Verification Desk sign-in (the Admin button in the top bar). Sign-in is off while the password is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123
ADMIN_NAME=Entitle reviewer

# Public address of this app, no trailing slash. An https address makes the session cookie secure-only.
BASE_URL=http://127.0.0.1:8000

# Optional SMTP delivery for people who opt into email updates on their profile.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Entitle Updates
SMTP_USE_TLS=true

# Optional n8n service that calls /api/internal/* with this shared secret.
N8N_BASE_URL=
N8N_SHARED_SECRET=change-me-shared-secret

PORT=8000
# SQLite works out of the box but resets when the container is rebuilt.
# For data that survives redeploys, use Neon: pooled URL here, direct URL below (used to create tables).
DATABASE_URL=sqlite:///./data/app.db
DATABASE_URL_UNPOOLED=
ENABLE_SCHEDULER=true
WATCHER_INTERVAL_SECONDS=1800
FETCH_REMOTE=true
